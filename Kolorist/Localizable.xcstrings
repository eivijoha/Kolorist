      }
    },
    "Oppgi refleksjonen (LRV) til et nøytralt kort eller en grå eller hvit flate med kjent verdi, for eksempel en malt vegg.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the reflectance (LRV) of a neutral card or a grey or white surface with a known value, such as a painted wall."
          }
        }
      }
    },
    "Opplevd lesekontrast etter APCA (WCAG 3-utkast)": {
      "localizations": {
