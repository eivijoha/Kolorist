    "Vurder fargene i paletten: harmoni, kontrast og fargesyn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assess the colours in the palette: harmony, contrast and colour vision"
          }
        }
      }
    },
    "Vurder paletten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critique the palette"
          }
        }
