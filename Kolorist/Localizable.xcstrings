    "CC BY 4.0": {
      "shouldTranslate": false
    },
    "CIE 15 (luminansfaktor Y); BS 8300-2:2018; TEK17 med veiledning, NS 11001-1:2018 og Byggforsk 220.114; NBKF Faglig veileder 3-2024; ISO 21542:2021; CAN-ASC-2.4 (utkast 2026)": {
