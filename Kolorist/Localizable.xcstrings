            "value": "Weaknesses"
          }
        }
      }
    },
    "Sveip for å skjule det du ikke bruker.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe to hide what you don’t use."
