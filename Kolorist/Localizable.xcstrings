          "stringUnit": {
            "state": "translated",
            "value": "With reference card (beta)"
          }
        }
      }
    },
    "Med spektre kan fasiten regnes ut i ethvert lys. Feltene vises slik de ser ut i valgt lys når øyet har tilpasset seg delvis.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With spectra, the reference values can be calculated in any light. The patches are shown as they look in the chosen light when the eye has partly adapted."
          }
        }
      }
    },
