      }
    },
    "«%@» er ikke en gyldig farge. Bruk hex eller CSS, f.eks. #2F7FD8 eller oklch(0.6 0.15 250).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a valid colour. Use hex or CSS, e.g. #2F7FD8 or oklch(0.6 0.15 250)."
          }
        }
      }
    },
    "«%@» er verken en ICC-profil (.icc, .icm) eller et fargebibliotek (.ase, .aco, .acb).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is neither an ICC profile (.icc, .icm) nor a colour library (.ase, .aco, .acb)."
          }
        }
      }
    },
    "«%@» flyttes til den nye gruppen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is moved to the new group."
          }
        }
      }
    },
    "«%@» kunne ikke leses: %@": {
      "localizations": {
