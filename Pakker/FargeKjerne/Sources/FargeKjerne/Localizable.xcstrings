    "Munsells sirkel med ti hovedkulører i like store opplevde steg, mye brukt i arkitektur og fargelære. Valør og kroma holdes fast; gul er komplementær til purpurblå.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munsell’s wheel with ten principal hues in equal perceived steps, widely used in architecture and colour education. Value and chroma are kept; yellow is complementary to purple-blue."
          }
        }
      }
    },
    "Mørkere": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Darker"
          }
        }
      }
    },
