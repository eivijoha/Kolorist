            "state": "translated",
            "value": "Accent"
          }
        }
      }
    },
    "Alle fargeparene holder kravet i alle moduser og tilstander.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All colour pairs meet the requirement in every mode and state."
          }
        }
      }
    },
