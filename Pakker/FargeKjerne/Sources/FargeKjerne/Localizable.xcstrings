          "stringUnit": {
            "state": "translated",
            "value": "Analogous"
          }
        }
      }
    },
    "Analog med aksent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analogous with accent"
          }
        }
      }
    },
    "Bakgrunn, flater, tekst, kanter og skillelinjer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background, surfaces, text, borders and separators"
